# Скопировать в .env и заполнить. В GitHub .env не коммитится.

# --- Приложение ---
FLASK_ENV=development
SECRET_KEY=change-me
TZ=Europe/Moscow
PORT=8000

# --- База ---
DATABASE_URL=sqlite:///data/registry.db
BACKUP_DIR=./backups

# --- Доступ в админ-панель ---
# Хеш пароля, а не пароль. Сгенерировать: python -c "from werkzeug.security import generate_password_hash as g; print(g('...'))"
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_DAYS=30
ADMIN_MAX_ATTEMPTS=5

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=

# --- Google Sheets ---
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/service-account.json
SHEETS_EXPORT_ENABLED=1
SHEETS_EXPORT_SPREADSHEET_ID=

# --- LLM (только извлечение полей) ---
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_CALLS_PER_RUN=200

# --- Автоматика ---
SCHEDULER_ENABLED=1
OUTREACH_DEFAULT_SEND_TIME=09:00
MAX_OUTREACH_TRIES=3
LINK_CHECK_INTERVAL_HOURS=6
SOURCE_HEALTH_INTERVAL_MINUTES=30

# --- Наблюдаемость ---
SENTRY_DSN=
LOG_LEVEL=INFO
