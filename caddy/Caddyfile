# Обратный прокси и TLS для Навигатора.
#
# Это ЕДИНСТВЕННЫЙ конфиг прокси в поставке. docs/DEPLOY-TLS.md на него
# ссылается и его содержимое не повторяет: две копии одного конфига один раз
# уже разъехались по ожидаемым кодам ответа, и исполнитель по матрице проверок
# начал «чинить» исправную защиту.
#
# Значения приезжают из /opt/eltera-bot/.env через docker-compose.yml.
# Правит файл git, а не рука на сервере: правка на месте оставляет рабочее
# дерево грязным, следующий `git pull --ff-only` откажет, а `git checkout`
# молча вернёт версию из репозитория — вместе со сменой центра сертификации.
#
# ВАЖНО про пустые значения. Переменная, объявленная в .env ПУСТОЙ, приезжает
# сюда пустой строкой, и подстановка {$VAR:значение-по-умолчанию} её НЕ
# подменяет — по умолчанию берётся только когда переменной нет вовсе.
# Неиспользуемые переменные в .env ЗАКОММЕНТИРОВАТЬ, а не обнулить.
#
# Последствия у пустого значения разные, и это важнее самого правила.
# Проверено запуском каждой из четырёх переменных:
#   NAVIGATOR_DOMAIN, ACME_EMAIL, ACME_CA — конфиг не разбирается вовсе
#     («server block without any key», «wrong argument count»), контейнер
#     уходит в цикл перезапусков. Отказ громкий, не пропустишь.
#   HSTS_MAX_AGE — отказа НЕТ. Caddy спокойно стартует и отдаёт
#     «Strict-Transport-Security: max-age=», то есть заголовок без числа.
#     Он невалиден, браузер его игнорирует, и HSTS оказывается выключен,
#     хотя заголовок в ответе присутствует. Ни одна проба живости этого не
#     заметит — поймает только матрица 6.1, которая ждёт ровно max-age=300.
{
	# Админ-API (порт 2019) выключен: конфиг едет из git, перезагружать его
	# по сети незачем, а на машине рядом живёт чужой продукт — лишний
	# управляющий порт там не нужен.
	admin off

	# Почта ACME-аккаунта. Умолчание заведомо нерабочее и названо так, чтобы
	# отказ читался прямо в логе: Let's Encrypt отвергнет регистрацию с
	# доменом .invalid, и в строке ошибки будет видно имя незаполненной
	# переменной. Тихо работать с чужой почтой этот конфиг не станет.
	# Каналом оповещения почта НЕ является: рассылку писем об истечении
	# Let's Encrypt прекратил 4 июня 2025 года. Срок держит внешняя проба
	# (scripts/tls_watch.sh).
	email {$ACME_EMAIL:set-ACME-EMAIL-in-env@example.invalid}

	# Боевой Let's Encrypt. На время репетиции выпуска (шаг 5 регламента)
	# в .env кладётся адрес staging-центра; сам файл при этом не правится.
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}

	# Без этого слова директива «metrics» на служебном порту ниже отдаёт только
	# состояние самого конфига, а счётчиков запросов не появляется вовсе.
	# Проверено запуском на caddy:2-alpine: без строки — ни одного семейства
	# caddy_http_*, со строкой — шесть, включая caddy_http_requests_total
	# и длительность ответа. Именно ради них заведён скрейп прокси: без них
	# «упало приложение» и «упал прокси» по графику не различить.
	metrics

	servers {
		timeouts {
			# Медленный клиент не должен держать соединение бесконечно:
			# это дешёвый способ занять прокси.
			read_header 10s
			idle 2m
		}

		# Только HTTP/1.1 и HTTP/2. HTTP/3 выключен НЕ из осторожности вообще,
		# а потому что в docker-compose.yml опубликован «443:443» — то есть
		# только TCP. С включённым h3 Caddy отдаёт заголовок
		# «Alt-Svc: h3=":443"», браузер верит ему и пробует UDP/443, который
		# снаружи закрыт: на каждое новое соединение получается неудачная
		# проба и откат на HTTP/2. Работать будет, но с задержкой и с
		# симптомом «иногда открывается медленно», у которого нет следа ни в
		# одном логе. Обещание должно совпадать с опубликованными портами.
		# Включать HTTP/3 — вместе с публикацией «443:443/udp», отдельной
		# задачей (docs/DEPLOY-TLS.md, 9.2).
		protocols h1 h2
	}
}

# Домен приходит из .env. Строки NAVIGATOR_DOMAIN нет — Caddy обслуживает
# localhost с самоподписанным сертификатом и в ACME не ходит вовсе. Это
# предохранитель: забытый домен виден на проверке шага 3 и при этом не
# расходует лимит «5 неудачных проверок в час».
{$NAVIGATOR_DOMAIN:localhost} {
	encode zstd gzip

	header {
		# HSTS лесенкой: начинаем с 5 минут. Заголовок необратим в пределах
		# max-age — снять его раньше срока нельзя ни с сервера, ни у
		# пользователя, поэтому год сразу означает «ошибка выкатки закрыла
		# домен на год». Поднимать через .env: 300 -> 86400 -> 31536000,
		# каждый шаг после нескольких дней без нареканий.
		Strict-Transport-Security "max-age={$HSTS_MAX_AGE:300}"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Версия и имя сервера наружу не нужны.
		-Server
	}

	# Машинные роуты снаружи не нужны: Prometheus скребёт app:8000 изнутри
	# docker-сети, мимо прокси, и от домена не зависит. Отдаём 404, а не 403:
	# 403 подтверждает, что путь существует. Главное — снаружи нельзя
	# перебирать Basic-пару: каждая неверная пара идёт в тот же лимит попыток
	# (app.py:395-403), что и вход по форме, и способна заблокировать вход
	# живым людям. 404 здесь — ПРАВИЛЬНЫЙ ответ; снимать этот блок, «чтобы
	# заработали метрики», не нужно ни при какой диагностике.
	@service path /metrics* /jobs* /health/details*
	handle @service {
		respond 404
	}

	handle {
		reverse_proxy app:8000 {
			# Штатный цикл выкатки — docker compose up -d --no-deps app:
			# апстрим исчезает на 10-40 секунд. Без этих двух строк каждое
			# обновление приложения отдаёт пользователям 502; с ними запрос
			# ждёт, пока контейнер поднимется, и человек видит паузу, а не
			# ошибку. 20 секунд заведомо перекрывают старт uvicorn.
			lb_try_duration 20s
			lb_try_interval 250ms

			# Заголовки задаёт прокси, а не клиент. По умолчанию Caddy к
			# X-Forwarded-* ДОПИСЫВАЕТ своё значение, оставляя клиентское;
			# форма «header_up Имя значение» ЗАМЕНЯЕТ заголовок целиком.
			# Это несущая конструкция, а не украшение:
			#   * X-Forwarded-For — app.py::_client_ip при TRUST_PROXY_HEADERS=1
			#     берёт ЛЕВЫЙ элемент. При дописывании это был бы адрес,
			#     присланный самим подбирающим пароль, и лимит «5 попыток
			#     с адреса» перестал бы существовать;
			#   * X-Forwarded-Proto — uvicorn 0.48 при ДВУХ копиях заголовка
			#     отбрасывает обе. Схема осталась бы http, _same_origin()
			#     сравнил бы https-Origin с http-base_url, и любой POST
			#     (вход, выход, смена пароля) отвечал бы 403.
			# `caddy validate` печатает на все три строки предупреждение
			# «Unnecessary header_up …: the reverse proxy's default behavior
			# is to pass headers to the upstream». Оно про факт передачи
			# заголовка, а не про его перезапись, и ожидаемо: строки нужны.
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			# RFC 7239. uvicorn его не читает, но и передавать наверх
			# клиентский заголовок незачем.
			header_up -Forwarded
		}
	}

	log {
		output stdout
		format console
	}
}

# Служебный порт самого прокси. Наружу не публикуется (в docker-compose.yml
# его нет в ports) — отвечает только внутри docker-сети. Нужен потому, что
# после закрытия прямого порта 8000 весь трафик идёт через Caddy, а за самой
# Caddy иначе не следит никто: приложение о своём состоянии рассказывает, а
# «сайт не открывается» обнаруживал бы первым позвонивший пользователь.
#
# Проверять живость прокси на 80 и 443 нельзя: 80 отвечает редиректом, 443
# требует сертификата на конкретное имя, и оба ответа зависят от DNS и ACME,
# то есть от вещей вне контейнера. Здесь нужен ровно признак «процесс жив и
# конфиг загружен».
# Блоки handle обязательны, и это не стиль: директивы внутри блока сайта
# выполняются не в порядке написания, а в жёстком порядке Caddy, где respond
# идёт РАНЬШЕ metrics. Написанные подряд `respond /healthz` и `metrics
# /metrics` дают 404 на метрики — проверено. handle взаимно исключающи и
# срабатывают в порядке написания.
:2020 {
	# Дёргает docker healthcheck каждые 30 секунд.
	handle /healthz {
		respond "ok" 200
	}
	# Скрейп Prometheus (job caddy в prometheus/prometheus.yml). Отсюда видно
	# число 502 на апстрим и длительность ответов — то есть отличить «упало
	# приложение» от «упал прокси» можно по графику, а не по звонку.
	handle /metrics {
		metrics
	}
	handle {
		respond 404
	}
}
