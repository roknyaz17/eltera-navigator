# Скопировать в .env и заполнить. Файл .env в репозиторий не коммитится.
# Здесь только ИМЕНА переменных и безопасные значения по умолчанию.
# Реальные токены, ключи и пароли сюда не вписывать никогда.
#
# Секция A — переменные, которые код читает СЕЙЧАС.
# Секция B — имена целевой системы: в коде пока не используются, оставлены,
#            чтобы при реализации они не разъехались. См. docs/OPEN-QUESTIONS.md.


# =============================================================================
# A. ИСПОЛЬЗУЕТСЯ КОДОМ
# =============================================================================

# --- Вход сотрудников --------------------------------------------------------
# Люди входят по почте и паролю на /login; роли — рекрутер и администратор.
# Без этих трёх переменных приложение НЕ ЗАПУСТИТСЯ: подписывать сессию и
# впускать первого администратора будет нечем.
#
#   SECRET_KEY          openssl rand -hex 32   (короче 32 символов — отказ старта)
#   AUTH_EMAIL          почта первого администратора
#   AUTH_PASSWORD_HASH  python scripts/set_password.py
#
# SECRET_KEY — это ещё и рубильник «погасить все выданные сессии». Cookie
# подписана им (auth.py:93-119) и больше ничем не защищена; новая строка здесь
# и пересоздание контейнера мгновенно обесценивают все ранее выданные cookie,
# в том числе выданные без флага Secure. Данные при этом не теряются: все
# пользователи просто входят заново (DEPLOY-TLS.md, шаг 9).
SECRET_KEY=
AUTH_EMAIL=
AUTH_PASSWORD_HASH=

# Срок сессии и лимит попыток входа с одного адреса.
SESSION_DAYS=7
LOGIN_MAX_ATTEMPTS=5
# Сколько живёт временный пароль, который администратор выдаёт сотруднику.
TEMP_PASSWORD_TTL_HOURS=48
# Эти две переменные читает код приложения, и пустое значение для них означает
# ровно «выключено» (auth.py:272, app.py:309) — обнулять их безопасно.
#
# 1 — когда вход идёт только по https. Включается ОДНОВРЕМЕННО с закрытием
# прямого порта 8000: по открытому http cookie с Secure браузер выбрасывает,
# и вход начинает молча возвращать на форму, без единой ошибки в логах.
SESSION_COOKIE_SECURE=
# 1 — только когда прямой порт 8000 наружу НЕ опубликован (APP_BIND_HOST=127.0.0.1).
# _client_ip (app.py:312-318) берёт левый элемент X-Forwarded-For и НЕ проверяет,
# от кого пришёл заголовок, — в отличие от uvicorn с FORWARDED_ALLOW_IPS.
# При открытом наружу порте это готовый обход лимита попыток входа.
TRUST_PROXY_HEADERS=

# --- Домен, HTTPS и обратный прокси ------------------------------------------
# Регламент выкатки — docs/DEPLOY-TLS.md, конфиг прокси — caddy/Caddyfile.
#
# ПРАВИЛО НА ВСЮ СЕКЦИЮ: пустое значение — НЕ то же самое, что отсутствие
# строки, и почти всегда хуже. Пустую строку docker compose передаёт дальше как
# пустое значение: Caddy получает директиву без аргумента и не разбирает конфиг,
# а uvicorn с пустым FORWARDED_ALLOW_IPS перестаёт доверять даже 127.0.0.1.
# Не используете переменную — ЗАКОММЕНТИРУЙТЕ строку, не обнуляйте.

# Поддомен, на котором открывается Навигатор: имя без схемы и без слэша.
# Строки нет — Caddy поднимется на localhost с самоподписанным сертификатом
# и в Let's Encrypt не пойдёт вовсе, то есть лимиты не расходуются.
#NAVIGATOR_DOMAIN=
# Почта администратора для ACME-аккаунта. Каналом оповещения она НЕ является:
# Let's Encrypt прекратил рассылку писем об истечении 4 июня 2025 года, письма
# о скором истечении не придёт никогда. Срок сертификата контролируется только
# внешней пробой — scripts/tls_watch.sh, см. DEPLOY-TLS.md, раздел 5.
#ACME_EMAIL=
# Удостоверяющий центр. Раскомментировать ТОЛЬКО на время репетиции выпуска
# (DEPLOY-TLS.md, шаг 5): лимиты staging кратно выше, сертификат нерабочий.
#ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# HSTS, секунды. Умолчание в Caddyfile — 300. Лесенка 300 -> 86400 -> 31536000,
# каждый шаг после нескольких дней без нареканий: заголовок необратим в пределах
# max-age, снять его раньше срока нельзя ни с сервера, ни у пользователя.
#HSTS_MAX_AGE=300
# Включает сервис caddy в docker-compose.yml. Без этой строки HTTPS-прокси не
# поднимается, а `docker compose up -d --remove-orphans` снесёт его контейнер.
# Пропажу строки ловит синтетическая проба входа (scripts/tls_watch.sh),
# а не звонок пользователя.
#COMPOSE_PROFILES=tls
# Адрес публикации порта приложения. Умолчание в docker-compose.yml — 0.0.0.0,
# то есть как боевой сервер работает сегодня: git pull не должен молча закрывать
# работающий адрес. Здесь, в образце, стоит 127.0.0.1 — развёртывание с нуля
# наружу приложение не отдаёт, снаружи его отдаёт Caddy.
# Последний шаг выкатки — добавить эту строку в боевой .env; откат — удалить.
APP_BIND_HOST=127.0.0.1
# То же для Prometheus (9090) и Grafana (3000) одной переменной: закрытие
# мониторинга — самостоятельное окно работ, оно не должно откатываться вместе
# с TLS. Умолчание в docker-compose.yml — 0.0.0.0 (как сейчас на сервере),
# здесь — 127.0.0.1. Доступ администратора после закрытия: ssh -N -L.
MONITORING_BIND_HOST=127.0.0.1
# Кому uvicorn верит в заголовках X-Forwarded-*. Переменную читает САМ uvicorn
# (0.48, forwarded_allow_ips), в коде приложения её нет — поэтому переезд за
# прокси не требует ни правки Dockerfile, ни пересборки образа. Проверено:
#   строки нет      -> 127.0.0.1: заголовки Caddy отбрасываются молча,
#                      схема остаётся http и любой POST отвечает 403
#   пустое значение -> не доверяет НИКОМУ, включая 127.0.0.1: хуже, чем без строки
#   172.16.0.0/12   -> вся частная сеть docker (172.16.0.0-172.31.255.255);
#                      внешний клиент с таким адресом до сервера не доедет,
#                      а переназначение подсети docker-сети ничего не ломает
#   *               -> доверять всем: допустимо, только если порт 8000 закрыт
# Раскомментировать на шаге 7 выкатки:
#FORWARDED_ALLOW_IPS=172.16.0.0/12

# --- Доступ машинных клиентов (Basic) ----------------------------------------
# Нужен Prometheus для /metrics. Открывает ТОЛЬКО /metrics, /jobs и
# /health/details — не всё приложение.
# Значение из примера здесь недопустимо: приложение не запустится.
# Тот же пароль положить в secrets/web_password (см. prometheus/README.md).
# 0 — выключить Basic, когда машинные клиенты переведены.
WEB_USER=
WEB_PASSWORD=
WEB_BASIC_ENABLED=1
# 1 — включить /docs и /openapi.json на время отладки. В проде выключено.
ENABLE_API_DOCS=

# --- База реестра ------------------------------------------------------------
# Файл SQLite. В контейнере — /app/data/registry.db на volume registry-data.
REGISTRY_DB_PATH=data/registry.db
# Префикс внутренних идентификаторов: ELT-2026-000123.
REGISTRY_ID_PREFIX=ELT
# 0 — аварийный откат на прежний путь через кеш Google Sheets.
REGISTRY_ENABLED=1
# 0 — не перезаписывать витрину в Google Таблице после прогона.
SHEETS_EXPORT_ENABLED=1

# --- LLM (только извлечение полей из текста заявки) --------------------------
# Ключ OpenAI-совместимого провайдера.
OPENAI_API_KEY=
# Базовый URL провайдера, если используется не api.openai.com.
TIMEWEB_BASE_URL=
# Цены для подсчёта стоимости прогона в логах, ₽ за миллион токенов.
LLM_PRICE_INPUT_RUB_PER_MTOK=18.9
LLM_PRICE_OUTPUT_RUB_PER_MTOK=37.8

# --- Telegram: чтение каналов через userbot (Telethon) -----------------------
# api_id / api_hash приложения с my.telegram.org.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# StringSession userbot'а. Получить: python auth_userbot.py — и скопировать вывод.
# Это полноценный доступ к аккаунту, а не токен бота: хранить как пароль.
TELEGRAM_SESSION=
# Числовые chat_id читаемых каналов (вида -100...).
TELEGRAM_VAHTAPRO_CHAT_ID=
TELEGRAM_AAAPLUS_CHAT_ID=
# Файл кеша выкачанных постов (telegram_post_fetcher.py).
TELEGRAM_POSTS_CACHE=
# Токен бота — используется только для ссылок в ответе /api/navigator.
TELEGRAM_BOT_TOKEN=

# --- База знаний проектов с Яндекс.Диска -------------------------------------
# 0 — не обновлять справку по проектам.
VAHTAPRO_KB_ENABLED=1
# Как часто переиндексировать диск, часов.
VAHTAPRO_KB_REFRESH_HOURS=

# --- Seatable ----------------------------------------------------------------
# Имя таблицы источника ЯППИ внутри базы Seatable.
SEATABLE_TABLE_YAPPI=

# --- Прочее ------------------------------------------------------------------
TZ=Europe/Moscow
# Пароль администратора Grafana. ПУСТОЕ значение здесь означает `admin`:
# в docker-compose.yml стоит ${GRAFANA_PASSWORD:-admin}, а подстановка :-
# срабатывает и на пустой строке. Пока порт 3000 опубликован наружу, это
# открытая панель (docs/DEPLOY-TLS.md, раздел 9.1). Менять эту строку на
# ${GRAFANA_PASSWORD:?...} НЕЛЬЗЯ: незаполненная переменная парализует весь
# compose-проект, включая команды отката.
GRAFANA_PASSWORD=

# Google Sheets авторизуется НЕ переменной окружения, а файлом credentials.json
# в корне проекта (JSON сервисного аккаунта). В контейнер монтируется на чтение.
# Файл в .gitignore. Идентификаторы таблиц зашиты константами в pipeline.py.


# =============================================================================
# B. ЦЕЛЕВАЯ СИСТЕМА — кодом пока не читается
# =============================================================================

# --- Telegram-робот: исходящие сообщения контрагентам ------------------------
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=

# --- Автоматика --------------------------------------------------------------
# Планировщик обязан работать ровно на одном инстансе.
SCHEDULER_ENABLED=1
OUTREACH_DEFAULT_SEND_TIME=09:00
MAX_OUTREACH_TRIES=3
LINK_CHECK_INTERVAL_HOURS=6
SOURCE_HEALTH_INTERVAL_MINUTES=30
LLM_MAX_CALLS_PER_RUN=200

# --- Эксплуатация ------------------------------------------------------------
BACKUP_DIR=./backups
LOG_LEVEL=INFO
SENTRY_DSN=
